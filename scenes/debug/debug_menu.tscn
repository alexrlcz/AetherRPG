size_flags_horizontal = 3
max_value = 999999.0
rounded = true

[node name="LevelLabel" type="Label" parent="Panel/Scroll/VBox/LevelRow"]
text = "Lv"

[node name="LevelSpin" type="SpinBox" parent="Panel/Scroll/VBox/LevelRow"]
unique_name_in_owner = true
min_value = 1.0
max_value = 99.0
value = 1.0
rounded = true

[node name="GenerateButton" type="Button" parent="Panel/Scroll/VBox/LevelRow"]
unique_name_in_owner = true
text = "Generate"

[node name="RandomLevelButton" type="Button" parent="Panel/Scroll/VBox"]
