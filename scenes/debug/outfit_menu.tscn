[node name="PauldronsCheck" type="CheckBox" parent="VBox/Grid"]
unique_name_in_owner = true

[node name="HeadLabel" type="Label" parent="VBox/Grid"]
text = "Head"

[node name="HeadOption" type="OptionButton" parent="VBox/Grid"]
unique_name_in_owner = true
size_flags_horizontal = 3

[node name="BackLabel" type="Label" parent="VBox/Grid"]
