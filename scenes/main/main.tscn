[ext_resource type="PackedScene" path="res://scenes/enemies/enemy_knight.tscn" id="5_enemy"]
[ext_resource type="Script" path="res://scripts/main/main.gd" id="6_main"]
[ext_resource type="Script" path="res://scripts/world/enemy_spawner.gd" id="7_spawner"]
[ext_resource type="PackedScene" path="res://scenes/debug/debug_menu.tscn" id="8_debug"]

[node name="Main" type="Node3D" node_paths=PackedStringArray("player")]
script = ExtResource("6_main")
player = NodePath("Player")

[node name="TestArena" parent="." instance=ExtResource("1_arena")]

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="Enemies" type="Node3D" parent="."]

[node name="EnemyKnight" parent="Enemies" instance=ExtResource("5_enemy")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6, 0, -12)

[node name="IsoCameraRig" parent="." instance=ExtResource("3_camera")]
target_path = NodePath("../Player")

[node name="HUD" parent="." node_paths=PackedStringArray("player_health") instance=ExtResource("4_hud")]
player_health = NodePath("../Player/HealthComponent")

[node name="EnemySpawner" type="Node" parent="." node_paths=PackedStringArray("container", "avoid")]
script = ExtResource("7_spawner")
enemy_scene = ExtResource("5_enemy")
container = NodePath("../Enemies")
avoid = NodePath("../Player")

[node name="DebugMenu" parent="." node_paths=PackedStringArray("spawner", "player_health", "enemies", "player_appearance") instance=ExtResource("8_debug")]
spawner = NodePath("../EnemySpawner")
player_health = NodePath("../Player/HealthComponent")
enemies = NodePath("../Enemies")
player_appearance = NodePath("../Player/Appearance")
